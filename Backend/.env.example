# Copy to Backend/.env for local development. On a host (Render etc.) set these
# as environment variables instead; never commit real values.

# MongoDB connection string (required). Local: mongodb://localhost:27017/snaptick
MONGO_URI=mongodb://localhost:27017/snaptick

# Long random string (required in production; the server refuses to start without it)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Port (Render sets this automatically)
PORT=5050

# Public URL of this API, used to build links to scan images
BASE_URL=http://localhost:5050

# Comma-separated front-end origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Face recognition service URL
DEEPFACE_URL=http://localhost:5001

# Optional: only allow registration with these email domains, e.g. abes.ac.in
ALLOWED_EMAIL_DOMAINS=

# Attendance days follow this time zone (important on UTC servers)
TZ=Asia/Kolkata

# development | production
NODE_ENV=development

# Comma-separated emails that become department admins (HOD) on sign-in
ADMIN_EMAILS=

# Attendance older than this many hours is locked (an admin can re-open a day)
EDIT_LOCK_HOURS=48

# Email for password-reset codes, low-attendance alerts and the weekly summary.
# Without these, emails are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SnapTick <no-reply@example.edu>

# Secret for GET /admin/summary/cron?key=... (weekly HOD summary from a cron service)
CRON_SECRET=
